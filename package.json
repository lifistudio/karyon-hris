{
  "name": "@hris/community",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:demo:plan": "tsx --env-file=.env src/scripts/seed-demo.ts",
    "seed:demo": "tsx --env-file=.env src/scripts/seed-demo.ts --apply",
    "build:db": "node scripts/build-db-tools.mjs",
    "test:api-docs": "tsx --tsconfig tsconfig.json --test src/lib/openapi.test.ts",
    "test:docs": "tsx --tsconfig tsconfig.json --test src/lib/docs/content.test.ts",
    "test:birthdays": "tsx --tsconfig tsconfig.json --test src/lib/hr/birthdays.test.ts",
    "test:time": "tsx --tsconfig tsconfig.json --test src/lib/time.test.ts",
    "test:barcode": "tsx --tsconfig tsconfig.json --test src/lib/barcode.test.ts",
    "test:security": "tsx --tsconfig tsconfig.json --test src/lib/api.security.test.ts src/lib/crypto.security.test.ts src/lib/rbac/scope.security.test.ts src/lib/storage/LocalProvider.security.test.ts src/lib/integrations/api-scopes.security.test.ts src/lib/export/export.security.test.ts src/lib/licensing/offer-parse.test.ts",
    "db:plan": "tsx --tsconfig tsconfig.json scripts/postgres.ts --app=hris --action=plan",
    "db:setup": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=setup",
    "db:reset": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=reset",
    "db:check": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=check",
    "db:cleanup": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=cleanup",
    "test:postgres": "tsx --tsconfig tsconfig.json --test packages/database/database.test.ts src/lib/postgres.test.ts packages/database/schema-sync.test.ts",
    "test:images": "tsx --tsconfig tsconfig.json --test src/lib/storage/image.test.ts",
    "test:inventory": "tsx --tsconfig tsconfig.json --test src/lib/inventory/inventory.test.ts",
    "test:tasks": "tsx --tsconfig tsconfig.json --test src/lib/hr/attendance-tasks.test.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "bcryptjs": "3.0.3",
    "framer-motion": "14.9.0",
    "leaflet": "1.9.4",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
